<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/class_ui.vcss_c" />
	</styles>
	<Panel class="ClassScreen" hittest="false">

		<Panel class="CrosshairBars" hittest="false">
			<Panel id="ChargeBar" class="Bar ChargeBar" hittest="false">
				<Label id="ChargeBarFill" class="BarFill" text="{s:fill}" hittest="false" />
				<Label id="ChargeBarEmpty" class="BarEmpty" text="{s:empty}" hittest="false" />
			</Panel>
		</Panel>

		<Panel class="BuildHints" hittest="false">
			<Panel class="BuildHintHalf" hittest="false">
				<Panel id="BuildHintLeft" class="BuildHint BuildHintLeft" hittest="false">
					<Label id="BuildHintLeftWord0" class="BuildHintWord" text="{s:word}" hittest="false" />
					<Label id="BuildHintLeftWord1" class="BuildHintWord BuildHintWord1" text="{s:word}" hittest="false" />
					<Label id="BuildHintLeftDetail" class="BuildHintDetail" text="{s:detail}" hittest="false" />
				</Panel>
			</Panel>
			<Panel class="BuildHintHalf" hittest="false">
				<Panel id="BuildHintRight" class="BuildHint BuildHintRight" hittest="false">
					<Label id="BuildHintRightWord0" class="BuildHintWord" text="{s:word}" hittest="false" />
					<Label id="BuildHintRightWord1" class="BuildHintWord BuildHintWord1" text="{s:word}" hittest="false" />
					<Label id="BuildHintRightDetail" class="BuildHintDetail" text="{s:detail}" hittest="false" />
				</Panel>
			</Panel>
		</Panel>

		<Panel id="PayloadBar" class="PayloadBar" hittest="false">
			<Panel class="PayloadSide" hittest="false" />
			<Label id="PayloadSection0Fill" class="PayloadFill" text="{s:fill}" hittest="false" />
			<Label id="PayloadSection0Empty" class="PayloadEmpty" text="{s:empty}" hittest="false" />
			<Panel id="PayloadTick1" class="PayloadTick" hittest="false" />
			<Label id="PayloadSection1Fill" class="PayloadFill" text="{s:fill}" hittest="false" />
			<Label id="PayloadSection1Empty" class="PayloadEmpty" text="{s:empty}" hittest="false" />
			<Panel id="PayloadTick2" class="PayloadTick" hittest="false" />
			<Label id="PayloadSection2Fill" class="PayloadFill" text="{s:fill}" hittest="false" />
			<Label id="PayloadSection2Empty" class="PayloadEmpty" text="{s:empty}" hittest="false" />
			<Panel id="PayloadTick3" class="PayloadTick" hittest="false" />
			<Label id="PayloadSection3Fill" class="PayloadFill" text="{s:fill}" hittest="false" />
			<Label id="PayloadSection3Empty" class="PayloadEmpty" text="{s:empty}" hittest="false" />
			<Panel id="PayloadTick4" class="PayloadTick" hittest="false" />
			<Label id="PayloadSection4Fill" class="PayloadFill" text="{s:fill}" hittest="false" />
			<Label id="PayloadSection4Empty" class="PayloadEmpty" text="{s:empty}" hittest="false" />
			<Panel id="PayloadTick5" class="PayloadTick" hittest="false" />
			<Label id="PayloadSection5Fill" class="PayloadFill" text="{s:fill}" hittest="false" />
			<Label id="PayloadSection5Empty" class="PayloadEmpty" text="{s:empty}" hittest="false" />
			<Label id="PayloadPushers" class="PayloadPushers" text="{s:pushers}" hittest="false" />
		</Panel>

		<Panel id="HudCards" class="HudCards" hittest="false">
			<Panel id="ClassMenu" class="ClassMenu">
				<Label class="MenuTitle" text="Select a Class" hittest="false" />
				<Panel class="ClassList">
					<Button id="Pick_soldier" class="ClassRow SoldierRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Soldier" hittest="false" />
							<Label id="PickStats_soldier" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="RPG &amp; Knife. Use the knife mid-air for massive damage!" hittest="false" />
					</Button>
					<Button id="Pick_demo" class="ClassRow DemoRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Exploder" hittest="false" />
							<Label id="PickStats_demo" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="Stickies &amp; Pipes. Right-click to detonate the footballs!" hittest="false" />
					</Button>
					<Button id="Pick_medic" class="ClassRow MedicRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Medic" hittest="false" />
							<Label id="PickStats_medic" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="Medic!" hittest="false" />
					</Button>
					<Button id="Pick_railer" class="ClassRow RailerRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Railer" hittest="false" />
							<Label id="PickStats_railer" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="Pea Shooter &amp; Beam Cannon. Try jumping with the beam!" hittest="false" />
					</Button>
					<Button id="Pick_beamer" class="ClassRow BeamerRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Beamer" hittest="false" />
							<Label id="PickStats_beamer" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="Minigun &amp; Shotguns. You're so big owo!" hittest="false" />
					</Button>
					<Button id="Pick_boxer" class="ClassRow BoxerRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Cuber" hittest="false" />
							<Label id="PickStats_boxer" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="Cubes &amp; Crap. The cubes feast on all!" hittest="false" />
					</Button>
					<Button id="Pick_shocker" class="ClassRow ShockerRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Shocker" hittest="false" />
							<Label id="PickStats_shocker" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="Ball &amp; Beam." hittest="false" />
					</Button>
					<Button id="Pick_shrinker" class="ClassRow ShrinkerRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Shrinker" hittest="false" />
							<Label id="PickStats_shrinker" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="Trapper. Left-click to lay a trap, Right-click to setup teleporters &amp; Knife. Right-click to toggle shrink" hittest="false" />
					</Button>
					<Button id="Pick_builder" class="ClassRow BuilderRow">
						<Panel class="ClassRowHead" hittest="false">
							<Label class="ClassRowName" text="Builder" hittest="false" />
							<Label id="PickStats_builder" class="ClassRowStats" text="{s:stats}" hittest="false" />
						</Panel>
						<Label class="ClassRowInfo" text="SHotgun &amp; Wrench. Left-click sniper turret, Right-click ppsh turret" hittest="false" />
					</Button>
				</Panel>
			</Panel>

			<Panel id="ClassIndicator" class="HudCard ClassIndicator" hittest="false">
				<Panel class="ClassStack" hittest="false">
					<Label id="ClassName" class="ClassName" text="{s:classname}" hittest="false" />
					<Label class="ClassHint HintClosed" text="E : Switch" hittest="false" />
					<Label class="ClassHint HintOpen" text="E : Close" hittest="false" />
				</Panel>
			</Panel>

			<Panel id="BuildingPanel" class="BuildingPanel" hittest="false">
				<Panel id="BuildingRow0" class="BuildingRow" hittest="false">
					<Panel class="BuildingRowTop" hittest="false">
						<Label id="BuildingName0" class="BuildingName" text="{s:name}" hittest="false" />
						<Label id="BuildingStatus0" class="BuildingStatus" text="{s:status}" hittest="false" />
					</Panel>
					<Panel class="BuildingRowHealth" hittest="false">
						<Panel id="BuildingHealth0" class="Bar BuildingHealthBar" hittest="false">
							<Label id="BuildingHealth0Fill" class="BarFill" text="{s:fill}" hittest="false" />
							<Label id="BuildingHealth0Empty" class="BarEmpty" text="{s:empty}" hittest="false" />
						</Panel>
						<Label id="BuildingHealthText0" class="BuildingHealthText" text="{s:health}" hittest="false" />
					</Panel>
				</Panel>
				<Panel id="BuildingRow1" class="BuildingRow" hittest="false">
					<Panel class="BuildingRowTop" hittest="false">
						<Label id="BuildingName1" class="BuildingName" text="{s:name}" hittest="false" />
						<Label id="BuildingStatus1" class="BuildingStatus" text="{s:status}" hittest="false" />
					</Panel>
					<Panel class="BuildingRowHealth" hittest="false">
						<Panel id="BuildingHealth1" class="Bar BuildingHealthBar" hittest="false">
							<Label id="BuildingHealth1Fill" class="BarFill" text="{s:fill}" hittest="false" />
							<Label id="BuildingHealth1Empty" class="BarEmpty" text="{s:empty}" hittest="false" />
						</Panel>
						<Label id="BuildingHealthText1" class="BuildingHealthText" text="{s:health}" hittest="false" />
					</Panel>
				</Panel>
				<Panel id="BuildingRow2" class="BuildingRow" hittest="false">
					<Panel class="BuildingRowTop" hittest="false">
						<Label id="BuildingName2" class="BuildingName" text="{s:name}" hittest="false" />
						<Label id="BuildingStatus2" class="BuildingStatus" text="{s:status}" hittest="false" />
					</Panel>
					<Panel class="BuildingRowHealth" hittest="false">
						<Panel id="BuildingHealth2" class="Bar BuildingHealthBar" hittest="false">
							<Label id="BuildingHealth2Fill" class="BarFill" text="{s:fill}" hittest="false" />
							<Label id="BuildingHealth2Empty" class="BarEmpty" text="{s:empty}" hittest="false" />
						</Panel>
						<Label id="BuildingHealthText2" class="BuildingHealthText" text="{s:health}" hittest="false" />
					</Panel>
				</Panel>
				<Panel id="BuildingRow3" class="BuildingRow" hittest="false">
					<Panel class="BuildingRowTop" hittest="false">
						<Label id="BuildingName3" class="BuildingName" text="{s:name}" hittest="false" />
						<Label id="BuildingStatus3" class="BuildingStatus" text="{s:status}" hittest="false" />
					</Panel>
					<Panel class="BuildingRowHealth" hittest="false">
						<Panel id="BuildingHealth3" class="Bar BuildingHealthBar" hittest="false">
							<Label id="BuildingHealth3Fill" class="BarFill" text="{s:fill}" hittest="false" />
							<Label id="BuildingHealth3Empty" class="BarEmpty" text="{s:empty}" hittest="false" />
						</Panel>
						<Label id="BuildingHealthText3" class="BuildingHealthText" text="{s:health}" hittest="false" />
					</Panel>
				</Panel>
			</Panel>

			<Panel id="CentreBar" class="HudCard CentreBar" hittest="false">
				<Panel id="HealthPanel" class="BarSection HealthPanel" hittest="false">
					<Panel class="HealthRow" hittest="false">
						<Panel class="HealthCross" hittest="false">
							<Panel class="CrossShape CrossEmpty" hittest="false">
								<Panel class="CrossBar CrossVertical" hittest="false" />
								<Panel class="CrossBar CrossArm CrossArmLeft" hittest="false" />
								<Panel class="CrossBar CrossArm CrossArmRight" hittest="false" />
							</Panel>
							<Panel id="HealthCrossFill" class="CrossFill" hittest="false">
								<Panel class="CrossShape" hittest="false">
									<Panel class="CrossBar CrossVertical" hittest="false" />
									<Panel class="CrossBar CrossArm CrossArmLeft" hittest="false" />
									<Panel class="CrossBar CrossArm CrossArmRight" hittest="false" />
								</Panel>
							</Panel>
						</Panel>
						<Label id="HealthValue" class="HealthValue" text="{s:health}" hittest="false" />
						<Label id="HealthMax" class="HealthMax" text="/ {s:maxhealth}" hittest="false" />
					</Panel>
				</Panel>

				<Panel class="BarDivider" hittest="false" />

				<Panel class="BarSection AmmoSection" hittest="false">
					<Panel id="AmmoPanel" class="AmmoPanel" hittest="false">
						<Panel class="AmmoRow" hittest="false">
							<Label id="AmmoClip" class="AmmoClip" text="{s:ammoclip}" hittest="false" />
							<Label id="AmmoSpare" class="AmmoSpare" text="/ {s:ammospare}" hittest="false" />
						</Panel>
						<Panel id="ReloadBar" class="Bar ReloadBar" hittest="false">
							<Label id="ReloadBarFill" class="BarFill" text="{s:fill}" hittest="false" />
							<Label id="ReloadBarEmpty" class="BarEmpty" text="{s:empty}" hittest="false" />
						</Panel>
					</Panel>

					<Panel id="CounterPanel" class="CounterPanel" hittest="false">
						<Label id="CounterLabel" class="CounterLabel" text="{s:counterlabel}" hittest="false" />
						<Label id="CounterValue" class="CounterValue" text="{s:countervalue}" hittest="false" />
						<Label id="CounterMax" class="CounterMax" text="{s:countermax}" hittest="false" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>